PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/swagtrickryan?retryWrites=true&w=majority
ADMIN_PASSWORD=choisis-un-mot-de-passe-solide
JWT_SECRET=une-longue-chaine-aleatoire
# Origines autorisées, séparées par des virgules (sans slash final, sans chemin)
CORS_ORIGINS=https://TON-USER.github.io,http://localhost:5173

# Upload de fichiers vers Cloudflare R2 (optionnel : sans ça, l'admin fonctionne par URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-86dc5b5484314368ac5436a674b0d919.r2.dev

# Notification par email des messages du formulaire de contact (optionnel).
# Sans ça, les messages arrivent quand même dans l'onglet "Messages" de l'admin.
# Compte gratuit sur resend.com : avec l'adresse d'envoi par défaut, tu ne peux recevoir que sur l'email de ton compte Resend.
RESEND_API_KEY=
CONTACT_TO=
RESEND_FROM=

# Bouton « Reconstruire le site » de l'admin (SEO) — optionnel
# GITHUB_REPO=LK10ar/swag
# GITHUB_TOKEN=  (jeton GitHub « fine-grained » avec la permission Actions : Read and write sur ce repo)
